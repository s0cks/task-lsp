{
  "separate-pull-requests": true,
  "packages": {
    "docker/build-env": {
      "release-type": "docker",
      "package-name": "build-env"
    },
    ".": {
      "release-type": "go",
      "extra-files": [
        "VERSION"
      ],
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true
    }
  }
}
