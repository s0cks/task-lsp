{
  "group-pull-request-title-pattern": "chore(main): release packages ${version}",
  "packages": {
    "docs": {
      "release-type": "node",
      "package-name": "docs",
      "include-component-in-tag": true,
      "skip-github-release": true,
      "skip-changelog": true
    },
    "docker/build-env": {
      "release-type": "simple",
      "package-name": "build-env",
      "include-component-in-tag": true
    },
    ".": {
      "release-type": "go",
      "package-name": "lsp",
      "include-component-in-tag": true,
      "extra-files": [
        "VERSION"
      ],
      "exclude-paths": [
        "docker/build-env",
        "docs"
      ],
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true
    }
  }
}
