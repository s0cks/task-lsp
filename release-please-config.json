{
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": false
    }
  ],
  "packages": {
    "docs": {
      "release-type": "node",
      "package-name": "docs",
      "include-component-in-tag": true,
      "skip-github-release": true,
      "skip-changelog": true,
      "versioning": "always-bump-minor"
    },
    "docker/build-env": {
      "release-type": "simple",
      "package-name": "build-env",
      "include-component-in-tag": true
    },
    ".": {
      "release-type": "go",
      "package-name": "taskfile-lsp",
      "include-component-in-tag": true,
      "extra-files": [
        "VERSION"
      ],
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true,
      "exclude-paths": [
        "docker",
        "docs"
      ]
    }
  }
}
