{
  "separate-pull-requests": true,
  "packages": {
    "docker/build-env": {
      "release-type": "simple",
      "package-name": "build-env",
      "include-component-in-tag": true
    },
    ".": {
      "release-type": "go",
      "package-name": "taskfile-lsp",
      "include-component-in-tag": true,
      "extra-files": [
        "VERSION"
      ],
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true
    }
  }
}
