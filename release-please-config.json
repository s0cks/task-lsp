{
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "packages": {
    "docs": {
      "release-type": "node",
      "package-name": "docs",
      "skip-changelog": true,
      "initial-version": "1.0.0"
    },
    "vscode": {
      "release-type": "node",
      "package-name": "vscode",
      "initial-version": "0.0.0",
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true
    },
    "docker/build-env": {
      "release-type": "simple",
      "package-name": "build-env",
      "initial-version": "1.0.0"
    },
    ".": {
      "release-type": "go",
      "package-name": "lsp",
      "extra-files": [
        "VERSION"
      ],
      "exclude-paths": [
        "docker/build-env",
        "docs",
        "vscode"
      ],
      "initial-version": "0.0.0",
      "bump-minor-pre-major": true,
      "bump-patch-pre-major": true
    }
  }
}
